#: includes/class-preflight.php
msgid "This plugin moves a single WordPress site. Multisite networks are not supported by this plugin yet."
msgstr "Este plugin mueve un único sitio WordPress. Las redes multisitio aún no son compatibles con este plugin."

#: includes/class-preflight.php
msgid "Single site"
msgstr "Sitio único"

#: includes/class-preflight.php
msgid "BladeCP can only connect to a WordPress dashboard served over HTTPS. Open this page with https:// (install an SSL certificate first if your site has none)."
msgstr "BladeCP solo puede conectarse a un escritorio de WordPress servido por HTTPS. Abre esta página con https:// (instala antes un certificado SSL si tu sitio no tiene)."

#: includes/class-preflight.php
msgid "Not available"
msgstr "No disponible"

#: includes/class-preflight.php
msgid "Secure connection"
msgstr "Conexión segura"

#: includes/class-preflight.php
msgid "HTTPS"
msgstr "HTTPS"

#: includes/class-preflight.php
msgid "Local test address (HTTP)"
msgstr "Dirección local de prueba (HTTP)"

#: includes/class-preflight.php
msgid "32-bit"
msgstr "32 bits"

#: includes/class-preflight.php
msgid "A 64-bit PHP is required to build packages larger than 2 GB. Ask your host to switch to 64-bit PHP."
msgstr "Se necesita PHP de 64 bits para crear paquetes de más de 2 GB. Pide a tu proveedor de hosting que use PHP de 64 bits."

#: includes/class-preflight.php
msgid "PHP build"
msgstr "Compilación de PHP"

#: includes/class-preflight.php
msgid "Streaming (cURL)"
msgstr "En flujo (cURL)"

#: includes/class-preflight.php
msgid "Upload method"
msgstr "Método de envío"

#: includes/class-preflight.php
msgid "In memory"
msgstr "En memoria"

#: includes/class-preflight.php
msgid "The PHP cURL extension is missing, so each 64 MB part is uploaded from memory. It works, but cURL is lighter."
msgstr "Falta la extensión cURL de PHP, así que cada parte de 64 MB se envía desde la memoria. Funciona, pero cURL es más ligero."

#: includes/class-preflight.php
msgid "The PHP cURL extension is missing and the memory limit is too low to upload 64 MB parts. Ask your host to enable cURL."
msgstr "Falta la extensión cURL de PHP y el límite de memoria es demasiado bajo para enviar partes de 64 MB. Pide a tu proveedor de hosting que active cURL."

#: includes/class-preflight.php
msgid "Compression"
msgstr "Compresión"

#: includes/class-preflight.php
msgid "gzip"
msgstr "gzip"

#: includes/class-preflight.php
msgid "Off"
msgstr "Desactivada"

#: includes/class-preflight.php
msgid "The PHP zlib extension is missing, so the package is not compressed and will take longer to upload."
msgstr "Falta la extensión zlib de PHP, así que el paquete no se comprime y tardará más en enviarse."

#: includes/class-preflight.php
msgid "Background work"
msgstr "Trabajo en segundo plano"

#: includes/class-preflight.php
msgid "WP-Cron is disabled on this site. Keep this page open while the package is built and uploaded."
msgstr "WP-Cron está desactivado en este sitio. Mantén esta página abierta mientras se crea y se envía el paquete."

#: includes/class-preflight.php
msgid "WP-Cron off"
msgstr "WP-Cron desactivado"

#: includes/class-preflight.php
msgid "Available"
msgstr "Disponible"

#: includes/class-preflight.php
msgid "Keeping this page open is fastest. If you close it, the work continues more slowly in the background."
msgstr "Mantener esta página abierta es lo más rápido. Si la cierras, el trabajo continúa en segundo plano, más despacio."

#: includes/class-preflight.php
msgid "Site address"
msgstr "Dirección del sitio"

#: includes/class-preflight.php
msgid "Sites served from a subfolder (for example example.com/blog) are not supported yet."
msgstr "Los sitios servidos desde una subcarpeta (por ejemplo example.com/blog) aún no son compatibles."

#: includes/class-preflight.php
msgid "This site keeps WordPress in its own folder, apart from the site address. This setup is not supported yet."
msgstr "Este sitio tiene WordPress en su propia carpeta, separada de la dirección del sitio. Esta configuración aún no es compatible."

#: includes/class-preflight.php
msgid "The site address cannot be used for a migration: use a regular domain name of up to 63 characters."
msgstr "La dirección del sitio no se puede usar para una migración: usa un nombre de dominio normal de hasta 63 caracteres."

#: includes/class-preflight.php
msgid "Encryption"
msgstr "Cifrado"

#: includes/class-preflight.php
msgid "OpenSSL (AES-256-GCM)"
msgstr "OpenSSL (AES-256-GCM)"

#: includes/class-preflight.php
msgid "sodium"
msgstr "sodium"

#. translators: 1: memory limit (for example 256 MB), 2: time limit in seconds or "none".
#: includes/class-preflight.php
#, php-format
msgid "Memory %1$s, time limit %2$s"
msgstr "Memoria %1$s, tiempo límite %2$s"

#: includes/class-preflight.php
msgid "unlimited"
msgstr "ilimitada"

#. translators: %d: seconds.
#: includes/class-preflight.php
#, php-format
msgid "%d s"
msgstr "%d s"

#: includes/class-preflight.php
msgid "none"
msgstr "ninguno"

#: includes/class-preflight.php
msgid "PHP limits"
msgstr "Límites de PHP"

#: includes/class-preflight.php
msgid "The memory limit is low. The plugin works in small steps, but raising it to 128 MB or more makes the migration faster and safer."
msgstr "El límite de memoria es bajo. El plugin trabaja en pasos pequeños, pero subirlo a 128 MB o más hace la migración más rápida y segura."

#: includes/class-preflight.php
msgid "The package is built in short steps, so low limits only make it slower."
msgstr "El paquete se crea en pasos cortos, así que los límites bajos solo lo hacen más lento."

#: includes/class-preflight.php
msgid "Site files"
msgstr "Archivos del sitio"

#: includes/class-preflight.php
msgid "Measuring..."
msgstr "Midiendo..."

#. translators: 1: number of files, 2: total size.
#: includes/class-preflight.php
#, php-format
msgid "%1$s file, %2$s"
msgid_plural "%1$s files, %2$s"
msgstr[0] "%1$s archivo, %2$s"
msgstr[1] "%1$s archivos, %2$s"

#. translators: %s: number of items.
#: includes/class-preflight.php
#, php-format
msgid "%s item cannot be copied (a symbolic link or an unreadable file) and will be skipped."
msgid_plural "%s items cannot be copied (symbolic links or unreadable files) and will be skipped."
msgstr[0] "%s elemento no se puede copiar (un enlace simbólico o un archivo ilegible) y se omitirá."
msgstr[1] "%s elementos no se pueden copiar (enlaces simbólicos o archivos ilegibles) y se omitirán."

#: includes/class-preflight.php
msgid "Database"
msgstr "Base de datos"

#. translators: 1: size, 2: number of tables.
#: includes/class-preflight.php
#, php-format
msgid "%1$s in %2$s table"
msgid_plural "%1$s in %2$s tables"
msgstr[0] "%1$s en %2$s tabla"
msgstr[1] "%1$s en %2$s tablas"

#: includes/class-preflight.php
msgid "The database table prefix uses characters the migration does not accept (only letters, digits and underscores)."
msgstr "El prefijo de las tablas de la base de datos usa caracteres que la migración no acepta (solo letras, números y guiones bajos)."

#: includes/class-preflight.php
msgid "The database character set or collation in wp-config.php uses characters the migration does not accept."
msgstr "El juego de caracteres o la intercalación de la base de datos en wp-config.php usa caracteres que la migración no acepta."

#: includes/class-preflight.php
msgid "Free disk space"
msgstr "Espacio libre en disco"

#: includes/class-preflight.php
msgid "Not writable"
msgstr "Sin permiso de escritura"

#: includes/class-preflight.php
msgid "The plugin cannot write to the uploads folder (wp-content/uploads), where the package is built. Check the folder permissions."
msgstr "El plugin no puede escribir en la carpeta de uploads (wp-content/uploads), donde se crea el paquete. Revisa los permisos de la carpeta."

#: includes/class-preflight.php
msgid "Unknown"
msgstr "Desconocido"

#: includes/class-preflight.php
msgid "This site is larger than the 50 GB limit of a migration package."
msgstr "Este sitio supera el límite de 50 GB de un paquete de migración."

#. translators: %s: estimated package size.
#: includes/class-preflight.php
#, php-format
msgid "The package is built here before it is sent, so it needs up to %s of free space."
msgstr "El paquete se crea aquí antes de enviarse, así que necesita hasta %s de espacio libre."

#: includes/class-preflight.php
msgid "This server does not report its free space."
msgstr "Este servidor no informa su espacio libre."

#: includes/class-preflight.php
