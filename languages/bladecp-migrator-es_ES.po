msgstr "Confirma tu dominio"

#: includes/class-phases.php
msgid "Preparing your new server"
msgstr "Preparando tu nuevo servidor"

#: includes/class-phases.php
msgid "Copying your files and database"
msgstr "Copiando tus archivos y tu base de datos"

#: includes/class-phases.php
msgid "Checking the migrated site"
msgstr "Comprobando el sitio migrado"

#: includes/class-phases.php
msgid "Ready for your review"
msgstr "Listo para tu revisión"

#: includes/class-phases.php
msgid "Applying your approval"
msgstr "Aplicando tu aprobación"

#: includes/class-phases.php
msgid "Migration completed"
msgstr "Migración completada"

#: includes/class-phases.php
msgid "The migration stopped"
msgstr "La migración se detuvo"

#: includes/class-phases.php
msgid "Migration cancelled"
msgstr "Migración cancelada"

#: includes/class-phases.php
msgid "Working on your migration"
msgstr "Trabajando en tu migración"

#: includes/class-phases.php
msgid "BladeCP is ready. Click \"Start migration\" to build and send the package."
msgstr "BladeCP está lista. Haz clic en \"Iniciar migración\" para crear y enviar el paquete."

#: includes/class-phases.php
msgid "The package is being sent to BladeCP."
msgstr "El paquete se está enviando a BladeCP."

#: includes/class-phases.php
msgid "BladeCP received the package and is reading it. This usually takes a few minutes."
msgstr "BladeCP recibió el paquete y lo está leyendo. Esto suele tardar unos minutos."

#: includes/class-phases.php
msgid "Check the domain BladeCP found in your site and confirm it to continue."
msgstr "Revisa el dominio que BladeCP encontró en tu sitio y confírmalo para continuar."

#: includes/class-phases.php
msgid "BladeCP is setting up a copy of your site. Your current site stays online and unchanged."
msgstr "BladeCP está preparando una copia de tu sitio. Tu sitio actual sigue en línea y sin cambios."

#: includes/class-phases.php
msgid "Open the preview, check that everything looks right, then approve the migration."
msgstr "Abre la vista previa, comprueba que todo se vea bien y aprueba la migración."

#: includes/class-phases.php
msgid "BladeCP is preparing your site to answer on your own domain."
msgstr "BladeCP está preparando tu sitio para responder en tu propio dominio."

#: includes/class-phases.php
msgid "Your site is already on your BladeCP server."
msgstr "Tu sitio ya está en tu servidor BladeCP."

#: includes/class-phases.php
msgid "BladeCP could not finish the migration. Your current site was not changed."
msgstr "BladeCP no pudo terminar la migración. Tu sitio actual no se cambió."

#: includes/class-phases.php
msgid "Nothing was changed on your current site. Connect again to start a new migration."
msgstr "No se cambió nada en tu sitio actual. Vuelve a conectarte para iniciar una migración nueva."

