msgid_plural "%1$s in %2$s tables"
msgstr[0] "%1$s em %2$s tabela"
msgstr[1] "%1$s em %2$s tabelas"

#: includes/class-preflight.php
msgid "The database table prefix uses characters the migration does not accept (only letters, digits and underscores)."
msgstr "O prefixo das tabelas do banco de dados usa caracteres que a migração não aceita (só letras, números e sublinhados)."

#: includes/class-preflight.php
msgid "The database character set or collation in wp-config.php uses characters the migration does not accept."
msgstr "O conjunto de caracteres ou o collation do banco de dados no wp-config.php usa caracteres que a migração não aceita."

